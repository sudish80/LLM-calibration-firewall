# LLM Firewall Configuration
# Copy to .env and adjust values

## Detection Thresholds
LLMFW_TOXICITY_THRESHOLD=0.5
LLMFW_SENTIMENT_THRESHOLD=0.9
LLMFW_SEMANTIC_THRESHOLD=0.8

## Neural Judge Thresholds
LLMFW_NEURAL_HARD_BLOCK_THRESHOLD=0.75
LLMFW_NEURAL_MODERATE_BLOCK_THRESHOLD=0.60
LLMFW_NEURAL_EDU_OVERRIDE_THRESHOLD=0.60
LLMFW_EDU_OVERRIDE_SCORE=0.35

## Hardware
LLMFW_DEVICE=auto

## Paths
LLMFW_CHROMADB_PERSIST_DIRECTORY=./data/chromadb
LLMFW_MODEL_CACHE_DIR=./data/models

## Models (override to use fine-tuned variants)
# LLMFW_MODEL_TOXICITY=unitary/toxic-bert
# LLMFW_MODEL_INTENT=facebook/bart-large-mnli
# LLMFW_MODEL_SENTIMENT=distilbert-base-uncased-finetuned-sst-2-english

## API Server
LLMFW_SERVER_HOST=0.0.0.0
LLMFW_SERVER_PORT=8000
LLMFW_SERVER_LOG_LEVEL=info
LLMFW_SERVER_WORKERS=1

## Authentication (leave empty to disable auth)
LLMFW_API_KEY=
# LLMFW_JWT_SECRET=
